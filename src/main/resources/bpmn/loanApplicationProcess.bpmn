<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_0pf2oo1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.39.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.19.0">
  <bpmn:message id="Message_178s6rp" name="Документы получены" />
  <bpmn:message id="Message_1bj6jg7" name="Отказано" />
  <bpmn:message id="Message_19d2dfq" name="Одобрено" />
  <bpmn:error id="Error_BLCheck" name="Error_BlacklistCheckFailed" errorCode="BLACKLIST_CHECK_ERROR" />
  <bpmn:collaboration id="Collaboration_0u3m2r6">
    <bpmn:participant id="Participant_1ds5upl" name="Подача заявки на кредит" processRef="loanApplicationProcess" />
  </bpmn:collaboration>
  <bpmn:process id="loanApplicationProcess" isExecutable="true" camunda:historyTimeToLive="P1D">
    <bpmn:startEvent id="StartEvent_LoanApplication">
      <bpmn:outgoing>Flow_StartToSubmitLoan</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_SubmitLoanApplication" name="Подать заявку" camunda:formKey="deployment:forms/loanForm.html">
      <bpmn:incoming>Flow_StartToSubmitLoan</bpmn:incoming>
      <bpmn:outgoing>Flow_SubmitLoanToNewClientCheck</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_CheckNewClient" name="Новый клиент?" default="Flow_ExistingClientToDecision">
      <bpmn:incoming>Flow_SubmitLoanToNewClientCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_NewClientToUploadDocs</bpmn:outgoing>
      <bpmn:outgoing>Flow_ExistingClientToDecision</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_UploadDocuments" name="Загрузить документы" camunda:formRef="docForm" camunda:formRefBinding="latest">
      <bpmn:incoming>Flow_NewClientToUploadDocs</bpmn:incoming>
      <bpmn:outgoing>Flow_UploadDocsToWaitGateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:eventBasedGateway id="Gateway_WaitDocuments" name="Ждем документы">
      <bpmn:incoming>Flow_UploadDocsToWaitGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_DocumentsReceived</bpmn:outgoing>
      <bpmn:outgoing>Flow_ThreeDaysTimeout</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:exclusiveGateway id="Gateway_MergeClientPaths">
      <bpmn:incoming>Flow_ExistingClientToDecision</bpmn:incoming>
      <bpmn:incoming>Flow_DocumentsToDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_ToParallelCheck</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Event_DocumentsReceived" name="Документы получены">
      <bpmn:incoming>Flow_DocumentsReceived</bpmn:incoming>
      <bpmn:outgoing>Flow_DocumentsToDecision</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0ae5es2" messageRef="Message_178s6rp" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Task_BlacklistCheck" name="Проверка ЧС" camunda:asyncBefore="true" camunda:delegateExpression="${blacklistCheck}">
      <bpmn:extensionElements>
        <camunda:executionListener delegateExpression="${processLogger}" event="end" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToBlacklistCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_BlacklistCheckWithoutErrors</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Gateway_ParallelChecks" camunda:asyncAfter="true">
      <bpmn:extensionElements>
        <camunda:executionListener delegateExpression="${processLogger}" event="start" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToParallelCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBlacklistCheck</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToCrediScorinCgall</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="Gateway_MergeChecks" camunda:asyncBefore="true">
      <bpmn:extensionElements>
        <camunda:executionListener delegateExpression="${processLogger}" event="end" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0es21l8</bpmn:incoming>
      <bpmn:incoming>Flow_1294t1g</bpmn:incoming>
      <bpmn:outgoing>Flow_ToApprovalDecision</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:intermediateThrowEvent id="Event_NotifyApproval" name="Уведомить об одобрении">
      <bpmn:incoming>Flow_ApprovalNotification</bpmn:incoming>
      <bpmn:outgoing>Flow_NotificationsToEndGatewayApproved</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0scvbpz" messageRef="Message_19d2dfq" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="Event_ThreeDays" name="3 дня">
      <bpmn:extensionElements>
        <camunda:executionListener expression="${bpmUtil.timeoutMessageCreate(execution, &#39;message&#39;, execution.getVariable(&#39;name&#39;), &#34;P3D&#34;)}" event="start" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ThreeDaysTimeout</bpmn:incoming>
      <bpmn:outgoing>Flow_ThreeDaysToRejectNotification</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_1l11p4n">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P3D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="Event_NotifyRejection" name="Уведомить об отказе">
      <bpmn:incoming>Flow_RejectNotification</bpmn:incoming>
      <bpmn:incoming>Flow_ThreeDaysToRejectNotification</bpmn:incoming>
      <bpmn:outgoing>Flow_NotificationsToEndGatewayRejected</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_11wfp7r" messageRef="Message_1bj6jg7" />
    </bpmn:intermediateThrowEvent>
    <bpmn:exclusiveGateway id="Gateway_IsApproved" name="Одобрено?">
      <bpmn:incoming>Flow_ApprovalToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_RejectNotification</bpmn:outgoing>
      <bpmn:outgoing>Flow_ApprovalNotification</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_MergeNotifications">
      <bpmn:incoming>Flow_NotificationsToEndGatewayRejected</bpmn:incoming>
      <bpmn:incoming>Flow_NotificationsToEndGatewayApproved</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndEvent</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_LoanProcessCompleted">
      <bpmn:incoming>Flow_ToEndEvent</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_BlacklistErrorHandler" name="Обработка ошибки ЧС" camunda:asyncBefore="true" camunda:delegateExpression="${blacklistErrorHandler}">
      <bpmn:extensionElements>
        <camunda:executionListener delegateExpression="${processLogger}" event="end" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToBlacklistErrorHandler</bpmn:incoming>
      <bpmn:outgoing>Flow_BlacklistCheckWithErrors</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_MergeBlacklist">
      <bpmn:incoming>Flow_BlacklistCheckWithErrors</bpmn:incoming>
      <bpmn:incoming>Flow_BlacklistCheckWithoutErrors</bpmn:incoming>
      <bpmn:outgoing>Flow_0es21l8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_1hs5nlt">
      <bpmn:incoming>Flow_1fjwsgy</bpmn:incoming>
      <bpmn:incoming>Flow_1aeezc1</bpmn:incoming>
      <bpmn:outgoing>Flow_1294t1g</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="Activity_CreditScorring" name="Кредитный скорринг" camunda:asyncBefore="true" calledElement="creditScoringProcess">
      <bpmn:extensionElements>
        <camunda:in source="clientId" target="clientId" />
        <camunda:out source="scoring" target="scoring" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToCrediScorinCgall</bpmn:incoming>
      <bpmn:outgoing>Flow_1aeezc1</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:serviceTask id="Task_SubProcessErrorHandler" name="Обработка ошибок" camunda:asyncBefore="true" camunda:delegateExpression="${scoringErrorHandler}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:outputParameter name="scoring">0</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_12xtv8u</bpmn:incoming>
      <bpmn:outgoing>Flow_1fjwsgy</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="BoundaryError_CreditScorring" attachedToRef="Activity_CreditScorring">
      <bpmn:outgoing>Flow_12xtv8u</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_1522zfp" errorRef="Error_Timeout" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="BoundaryError_BlackListCheck" attachedToRef="Task_BlacklistCheck">
      <bpmn:extensionElements>
        <camunda:executionListener delegateExpression="${processLogger}" event="end" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_ToBlacklistErrorHandler</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_07z7xh8" errorRef="Error_BLCheck" camunda:errorCodeVariable="loanErrorCode" camunda:errorMessageVariable="loanErrorMessage" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_StartToSubmitLoan" sourceRef="StartEvent_LoanApplication" targetRef="Task_SubmitLoanApplication" />
    <bpmn:sequenceFlow id="Flow_SubmitLoanToNewClientCheck" sourceRef="Task_SubmitLoanApplication" targetRef="Gateway_CheckNewClient" />
    <bpmn:sequenceFlow id="Flow_NewClientToUploadDocs" name="Да" sourceRef="Gateway_CheckNewClient" targetRef="Task_UploadDocuments">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">  ${execution.getVariable("isNewClient") == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ExistingClientToDecision" name="Нет" sourceRef="Gateway_CheckNewClient" targetRef="Gateway_MergeClientPaths" />
    <bpmn:sequenceFlow id="Flow_UploadDocsToWaitGateway" sourceRef="Task_UploadDocuments" targetRef="Gateway_WaitDocuments" />
    <bpmn:sequenceFlow id="Flow_DocumentsReceived" sourceRef="Gateway_WaitDocuments" targetRef="Event_DocumentsReceived" />
    <bpmn:sequenceFlow id="Flow_ThreeDaysTimeout" sourceRef="Gateway_WaitDocuments" targetRef="Event_ThreeDays" />
    <bpmn:sequenceFlow id="Flow_DocumentsToDecision" sourceRef="Event_DocumentsReceived" targetRef="Gateway_MergeClientPaths" />
    <bpmn:sequenceFlow id="Flow_ToParallelCheck" sourceRef="Gateway_MergeClientPaths" targetRef="Gateway_ParallelChecks" />
    <bpmn:sequenceFlow id="Flow_ToBlacklistCheck" sourceRef="Gateway_ParallelChecks" targetRef="Task_BlacklistCheck" />
    <bpmn:sequenceFlow id="Flow_BlacklistCheckWithoutErrors" sourceRef="Task_BlacklistCheck" targetRef="Gateway_MergeBlacklist">
      <bpmn:extensionElements />
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ToApprovalDecision" sourceRef="Gateway_MergeChecks" targetRef="Task_ApprovalDecision" />
    <bpmn:sequenceFlow id="Flow_ApprovalToGateway" sourceRef="Task_ApprovalDecision" targetRef="Gateway_IsApproved" />
    <bpmn:sequenceFlow id="Flow_ToCrediScorinCgall" sourceRef="Gateway_ParallelChecks" targetRef="Activity_CreditScorring" />
    <bpmn:sequenceFlow id="Flow_0es21l8" sourceRef="Gateway_MergeBlacklist" targetRef="Gateway_MergeChecks" />
    <bpmn:sequenceFlow id="Flow_1294t1g" sourceRef="Gateway_1hs5nlt" targetRef="Gateway_MergeChecks" />
    <bpmn:sequenceFlow id="Flow_ApprovalNotification" name="да" sourceRef="Gateway_IsApproved" targetRef="Event_NotifyApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approvalResult == "APPROVED"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NotificationsToEndGatewayApproved" sourceRef="Event_NotifyApproval" targetRef="Gateway_MergeNotifications" />
    <bpmn:sequenceFlow id="Flow_ThreeDaysToRejectNotification" sourceRef="Event_ThreeDays" targetRef="Event_NotifyRejection" />
    <bpmn:sequenceFlow id="Flow_RejectNotification" name="нет" sourceRef="Gateway_IsApproved" targetRef="Event_NotifyRejection">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approvalResult != "APPROVED"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NotificationsToEndGatewayRejected" sourceRef="Event_NotifyRejection" targetRef="Gateway_MergeNotifications" />
    <bpmn:sequenceFlow id="Flow_ToEndEvent" sourceRef="Gateway_MergeNotifications" targetRef="EndEvent_LoanProcessCompleted" />
    <bpmn:sequenceFlow id="Flow_ToBlacklistErrorHandler" sourceRef="BoundaryError_BlackListCheck" targetRef="Task_BlacklistErrorHandler" />
    <bpmn:sequenceFlow id="Flow_BlacklistCheckWithErrors" sourceRef="Task_BlacklistErrorHandler" targetRef="Gateway_MergeBlacklist" />
    <bpmn:sequenceFlow id="Flow_1fjwsgy" sourceRef="Task_SubProcessErrorHandler" targetRef="Gateway_1hs5nlt" />
    <bpmn:sequenceFlow id="Flow_1aeezc1" sourceRef="Activity_CreditScorring" targetRef="Gateway_1hs5nlt" />
    <bpmn:sequenceFlow id="Flow_12xtv8u" sourceRef="BoundaryError_CreditScorring" targetRef="Task_SubProcessErrorHandler" />
    <bpmn:businessRuleTask id="Task_ApprovalDecision" name="Одобрить/отклонить" camunda:resultVariable="approvalResult" camunda:decisionRef="loanApprovalDecision" camunda:mapDecisionResult="singleEntry">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="blackList">${execution.getVariable("blackList")}</camunda:inputParameter>
          <camunda:inputParameter name="scoring">${scoring}</camunda:inputParameter>
          <camunda:inputParameter name="income">${execution.getVariable("income")}</camunda:inputParameter>
        </camunda:inputOutput>
        <camunda:executionListener delegateExpression="${processLogger}" event="end" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToApprovalDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_ApprovalToGateway</bpmn:outgoing>
    </bpmn:businessRuleTask>
  </bpmn:process>
  <bpmn:error id="Error_Timeout" name="TimeoutError" errorCode="TIMEOUT" />
  <bpmndi:BPMNDiagram id="BPMNloanApplicationProcess">
    <bpmndi:BPMNPlane id="BPMNPlane_LoanApplicationProcess" bpmnElement="Collaboration_0u3m2r6">
